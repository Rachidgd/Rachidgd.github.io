    "faq": {
      "type": "cc-faq-accordeon-animee",
      "blocks": {
        "q1": { "type": "question", "settings": { "column": "left", "question": "Partez-vous d'un thème existant ou de zéro ?", "answer": "Nous développons en Liquid natif à partir d'une base saine. Pas de page builder, pas de thème du commerce revendu tel quel.", "open_by_default": true } },
        "q2": { "type": "question", "settings": { "column": "left", "question": "Combien d'applications installez-vous ?", "answer": "Le moins possible. Chaque application ajoute du poids, un coût mensuel et une dépendance. Nous n'en gardons une que si elle sert vraiment le parcours d'achat.", "open_by_default": false } },
        "q3": { "type": "question", "settings": { "column": "left", "question": "Pouvez-vous reprendre une boutique déjà en ligne ?", "answer": "Oui. Nous auditons l'existant, puis nous corrigeons ou nous refondons selon ce qui coûte le moins cher sur la durée.", "open_by_default": false } },
        "q4": { "type": "question", "settings": { "column": "right", "question": "Gérez-vous la migration depuis une autre plateforme ?", "answer": "Oui : produits, clients, commandes et redirections. Les redirections sont la partie qui protège votre référencement, elles se préparent avant la bascule.", "open_by_default": false } },
        "q5": { "type": "question", "settings": { "column": "right", "question": "Le SEO sur Shopify, c'est différent ?", "answer": "Sur le fond non, sur la forme oui. Collections, fiches produits, variantes et pagination demandent des arbitrages propres à la plateforme.", "open_by_default": false } },
        "q6": { "type": "question", "settings": { "column": "right", "question": "Qui garde la main sur la boutique ?", "answer": "Vous. Le compte Shopify, le domaine et les données restent à votre nom. Nous intervenons dessus, nous ne les détenons pas.", "open_by_default": false } }
      },
      "block_order": ["q1", "q2", "q3", "q4", "q5", "q6"],
