    "faq": {
      "type": "cc-faq-accordeon-animee",
      "blocks": {
        "q1": { "type": "question", "settings": { "column": "left", "question": "Combien de temps prend la création d'un site vitrine ?", "answer": "Comptez quelques semaines entre le cadrage et la mise en ligne. Le délai dépend surtout du nombre de pages et de la disponibilité de vos contenus.", "open_by_default": true } },
        "q2": { "type": "question", "settings": { "column": "left", "question": "Puis-je modifier le site moi-même ensuite ?", "answer": "Oui. Chaque texte, image et section se règle depuis l'éditeur de thème. Changer un horaire ou une photo ne demande pas de nous rappeler.", "open_by_default": false } },
        "q3": { "type": "question", "settings": { "column": "left", "question": "Rédigez-vous les textes ?", "answer": "Oui si vous le souhaitez. Nous partons de votre offre et de vos clients pour écrire des pages qui expliquent avant de vendre.", "open_by_default": false } },
        "q4": { "type": "question", "settings": { "column": "right", "question": "Le site est-il optimisé pour Google ?", "answer": "La base l'est : structure des titres, vitesse, balises, données structurées. Le référencement se travaille ensuite dans la durée, page par page.", "open_by_default": false } },
        "q5": { "type": "question", "settings": { "column": "right", "question": "À qui appartiennent le domaine et l'hébergement ?", "answer": "À vous. Le domaine, l'hébergement et les accès restent rattachés à votre organisation, quoi qu'il arrive ensuite.", "open_by_default": false } },
        "q6": { "type": "question", "settings": { "column": "right", "question": "Que se passe-t-il après la mise en ligne ?", "answer": "Vous repartez avec un site autonome et une prise en main. Nous restons joignables si un besoin dépasse ce que vous pouvez faire seul.", "open_by_default": false } }
