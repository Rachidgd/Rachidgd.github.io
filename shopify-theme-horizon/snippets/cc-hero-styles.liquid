{%- comment -%}
  Feuille de style de la section Hero.
  Sortie du fichier de section pour deux raisons : elle suit la convention
  d'Horizon (slideshow-styles, predictive-search-styles…), et elle garde
  chaque fichier sous le plafond de taille de l'API de thème.

  render a une portée isolée : la section doit lui passer explicitement s
  (section.settings), uid (section.id) et motion.
{%- endcomment -%}

<style>
  #shopify-section-{{ uid }} .cc-hero {
    --cc-hero-pt-min: {{ s.pt_mobile }};
    --cc-hero-pt-max: {{ s.pt_desktop }};
    --cc-hero-pb-min: {{ s.pb_mobile }};
    --cc-hero-pb-max: {{ s.pb_desktop }};
    position: relative;
    padding-block:
      calc(var(--cc-hero-pt-min) * 1px + (var(--cc-hero-pt-max) - var(--cc-hero-pt-min)) * var(--cc-fluid-t))
      calc(var(--cc-hero-pb-min) * 1px + (var(--cc-hero-pb-max) - var(--cc-hero-pb-min)) * var(--cc-fluid-t));
    {%- if s.bg_color != blank %}background-color: {{ s.bg_color }};{% endif %}
    overflow: clip;
  }

  #shopify-section-{{ uid }} .cc-hero__inner {
    display: flex;
    flex-direction: column;
    {%- if s.align == 'left' -%}
    align-items: flex-start;
    text-align: left;
    {%- else -%}
    align-items: center;
    text-align: center;
    {%- endif -%}
    position: relative;
    z-index: 2;
  }

  /* --- Bandeau de réassurance -------------------------------------------- */
  #shopify-section-{{ uid }} .cc-hero__proof {
    display: inline-flex;
    align-items: center;
    gap: {{ s.proof_gap }}px;
    margin-bottom: calc({{ s.proof_mb_min }} * 1px + ({{ s.proof_mb_max }} - {{ s.proof_mb_min }}) * var(--cc-fluid-t));
  }
  #shopify-section-{{ uid }} .cc-hero__avatars { display: flex; }
  #shopify-section-{{ uid }} .cc-hero__avatars .cc-round {
    --cc-sz-min: {{ s.avatar_size_mobile }};
    --cc-sz-max: {{ s.avatar_size_desktop }};
    --cc-round-size: calc(var(--cc-sz-min) * 1px + (var(--cc-sz-max) - var(--cc-sz-min)) * var(--cc-fluid-t));
    box-shadow: 0 0 0 2px {{ s.avatar_ring }};
  }
  #shopify-section-{{ uid }} .cc-hero__avatars .cc-round + .cc-round {
    margin-inline-start: calc(var(--cc-round-size) * -0.3);
  }
  #shopify-section-{{ uid }} .cc-hero__proof-text {
    --cc-fs-min: {{ s.proof_fs_mobile }};
    --cc-fs-max: {{ s.proof_fs_desktop }};
    font-size: calc(var(--cc-fs-min) * 1px + (var(--cc-fs-max) - var(--cc-fs-min)) * var(--cc-fluid-t));
    line-height: 1.4;
    color: {{ s.proof_color }};
  }

  /* --- Titre -------------------------------------------------------------- */
  #shopify-section-{{ uid }} .cc-hero__title {
    --cc-fs-min: {{ s.h1_fs_mobile }};
    --cc-fs-max: {{ s.h1_fs_desktop }};
    max-width: {{ s.h1_max_width }}ch;
    font-family: var(--cc-font-heading);
    font-size: calc(var(--cc-fs-min) * 1px + (var(--cc-fs-max) - var(--cc-fs-min)) * var(--cc-fluid-t));
    font-weight: {{ s.h1_weight }};
    line-height: calc(var(--cc-heading-leading) / 100);
    letter-spacing: var(--cc-heading-tracking);
    text-wrap: balance;
  }
  #shopify-section-{{ uid }} .cc-hero__title { color: {{ s.color_ink }}; }
  #shopify-section-{{ uid }} .cc-hero__seg--default { color: {{ s.color_ink }}; }
  #shopify-section-{{ uid }} .cc-hero__seg--muted   { color: {{ s.color_muted }}; }
  #shopify-section-{{ uid }} .cc-hero__seg--accent  { color: {{ s.color_accent }}; }
  #shopify-section-{{ uid }} .cc-hero__seg--on-dark { color: {{ s.color_light }}; }

  /* --- Bulles ------------------------------------------------------------- */
  #shopify-section-{{ uid }} .cc-bubble {
    --cc-round-size: calc(var(--cc-sz-min) * 1px + (var(--cc-sz-max) - var(--cc-sz-min)) * var(--cc-fluid-t));
    /* Géométrie verrouillée : un thème hôte peut poser des règles globales sur
       img ou sur les médias de section qui écraseraient la pastille et la
       rendraient ovale. Le sélecteur d'identifiant passe devant. */
    display: inline-block;
    inline-size: var(--cc-round-size);
    block-size: var(--cc-round-size);
    min-inline-size: var(--cc-round-size);
    min-block-size: var(--cc-round-size);
    max-inline-size: none;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    flex: 0 0 auto;
    vertical-align: middle;
    position: relative;
    top: {{ s.bubble_shift }}px;
    margin-inline: {{ s.bubble_gap }}px;
{%- if s.bubble_ring_width > 0 %}
    box-shadow: 0 0 0 {{ s.bubble_ring_width }}px {{ s.bubble_ring_color }};
{%- endif %}
  }
  {%- if motion -%}
  #shopify-section-{{ uid }} .cc-bubble {
    animation-name: cc-float-{{ uid }};
    animation-timing-function: cubic-bezier(0.45, 0.05, 0.55, 0.95);
    animation-iteration-count: infinite;
    will-change: transform;
  }
  @keyframes cc-float-{{ uid }} {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    25%      { transform: translate3d(var(--cc-fx), calc(var(--cc-fy) * -0.72), 0) rotate(var(--cc-fr)); }
    50%      { transform: translate3d(0, calc(var(--cc-fy) * -1), 0) rotate(0deg); }
    75%      { transform: translate3d(calc(var(--cc-fx) * -1), calc(var(--cc-fy) * -0.72), 0) rotate(calc(var(--cc-fr) * -1)); }
  }
  {%- endif -%}

  #shopify-section-{{ uid }} .cc-bubble > img,
  #shopify-section-{{ uid }} .cc-bubble > svg,
  #shopify-section-{{ uid }} .cc-hero__avatars .cc-round > img,
  #shopify-section-{{ uid }} .cc-hero__avatars .cc-round > svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    min-inline-size: 100%;
    min-block-size: 100%;
    max-inline-size: none;
    max-block-size: none;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
  }
  #shopify-section-{{ uid }} .cc-hero__avatars .cc-round {
    display: inline-block;
    inline-size: var(--cc-round-size);
    block-size: var(--cc-round-size);
    min-inline-size: var(--cc-round-size);
    min-block-size: var(--cc-round-size);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    flex: 0 0 auto;
  }

  /* --- Sous-titre et action ---------------------------------------------- */
  #shopify-section-{{ uid }} .cc-hero__sub {
    --cc-fs-min: {{ s.sub_fs_mobile }};
    --cc-fs-max: {{ s.sub_fs_desktop }};
    max-width: {{ s.sub_max_width }}ch;
    margin-top: calc({{ s.sub_mt_min }} * 1px + ({{ s.sub_mt_max }} - {{ s.sub_mt_min }}) * var(--cc-fluid-t));
    font-size: calc(var(--cc-fs-min) * 1px + (var(--cc-fs-max) - var(--cc-fs-min)) * var(--cc-fluid-t));
    line-height: calc(var(--cc-body-leading) / 100);
    color: {{ s.sub_color }};
    text-wrap: pretty;
  }
  #shopify-section-{{ uid }} .cc-hero__cta {
    --cc-btn-fs-min: {{ s.cta_fs_mobile }};
    --cc-btn-fs-max: {{ s.cta_fs_desktop }};
    --cc-btn-py: {{ s.cta_pad_y }}px;
    --cc-btn-px: {{ s.cta_pad_x }}px;
    margin-top: calc({{ s.cta_mt_min }} * 1px + ({{ s.cta_mt_max }} - {{ s.cta_mt_min }}) * var(--cc-fluid-t));
  }

  /* --- Visuel flottant ---------------------------------------------------- */
  {%- if s.float_image != blank -%}
  #shopify-section-{{ uid }} .cc-hero__float {
    position: absolute;
    z-index: 1;
    inset-inline-end: {{ s.float_offset_x }}px;
    inset-block-end: {{ s.float_offset_y }}px;
    inline-size: calc({{ s.float_width_mobile }} * 1px + ({{ s.float_width_desktop }} - {{ s.float_width_mobile }}) * var(--cc-fluid-t));
    border-radius: {{ s.float_radius }}px;
    overflow: hidden;
    rotate: {{ s.float_rotate }}deg;
    box-shadow: 0 24px 60px -24px rgba(var(--cc-ink-rgb), 0.45);
    pointer-events: none;
  }
  #shopify-section-{{ uid }} .cc-hero__float img { inline-size: 100%; block-size: auto; }
  {%- if s.float_hide_mobile -%}
  @media (max-width: 767px) {
    #shopify-section-{{ uid }} .cc-hero__float { display: none; }
  }
  {%- endif -%}
  {%- endif -%}

  /* --- Réglages mobile ----------------------------------------------------- */
  {%- if s.collapse_breaks_mobile -%}
  @media (max-width: 767px) {
    #shopify-section-{{ uid }} .cc-hero__title br { display: none; }
  }
  {%- endif -%}
</style>
