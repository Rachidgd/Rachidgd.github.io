    { "type": "image_picker", "id": "avatar_4", "label": "Portrait 4" },
    {
      "type": "paragraph",
      "content": "Utilisez de vraies photos de clients ou de dirigeants accompagnés, avec leur accord. Des portraits de banque d'images sur une preuve sociale se repèrent, et se retournent contre la crédibilité de la page."
    },
    { "type": "range", "id": "avatar_size_mobile", "label": "Diamètre des portraits — mobile", "unit": "px", "min": 18, "max": 48, "step": 1, "default": 22 },
    { "type": "range", "id": "avatar_size_desktop", "label": "Diamètre des portraits — desktop", "unit": "px", "min": 20, "max": 64, "step": 1, "default": 26 },
    { "type": "color", "id": "avatar_ring", "label": "Liseré autour des portraits", "default": "#f0eeec" },
    { "type": "range", "id": "proof_fs_mobile", "label": "Taille du texte — mobile", "unit": "px", "min": 11, "max": 20, "step": 1, "default": 13 },
    { "type": "range", "id": "proof_fs_desktop", "label": "Taille du texte — desktop", "unit": "px", "min": 12, "max": 22, "step": 1, "default": 15 },
    { "type": "color", "id": "proof_color", "label": "Couleur du texte", "default": "#3e3a35" },
    { "type": "range", "id": "proof_gap", "label": "Espace portraits / texte", "unit": "px", "min": 4, "max": 24, "step": 1, "default": 10 },
    { "type": "range", "id": "proof_mb_min", "label": "Espace sous le bandeau — mobile", "unit": "px", "min": 8, "max": 48, "step": 1, "default": 20 },
    { "type": "range", "id": "proof_mb_max", "label": "Espace sous le bandeau — desktop", "unit": "px", "min": 8, "max": 64, "step": 1, "default": 34 },

    { "type": "header", "content": "Titre principal (H1)" },
