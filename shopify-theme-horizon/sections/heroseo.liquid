{%- comment -%}
  ==========================================================================
  Clickscreation — Hero d'accueil (offre SEO)
  --------------------------------------------------------------------------
  Le titre H1 n'est pas une chaîne figée : il se compose de blocks dans
  l'éditeur de thème. Trois types sont disponibles et se combinent librement :

    · Segment de texte  — un mot ou un groupe de mots, avec sa propre couleur
    · Bulle             — une image circulaire insérée dans le fil du titre
    · Retour à la ligne — pour maîtriser la découpe typographique

  Les bulles : c'est la bulle qui impose son diamètre, jamais l'image. Le
  recadrage carré est fait côté CDN Shopify (crop centré, ou point focal si
  défini dans l'admin) puis object-fit: cover côté CSS. Une image portrait ou
  panoramique donnera donc toujours le même cercle, aux mêmes dimensions.

  Garde-fou d'animation : le réglage global settings.cc_motion n'existe pas
  dans un thème hôte comme Horizon. Sa valeur y est nulle, donc fausse, ce qui
  coupait toutes les animations. La condition ne retient donc qu'une
  désactivation explicite du marchand.

  L'animation de flottement n'agit que sur transform (translation et légère
  rotation, jamais d'échelle) : le diamètre reste constant, le calque est
  composité par le GPU, et le texte ne bouge pas d'un pixel — aucun CLS.
  ==========================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id

  assign cta_url = s.cta_url
  if cta_url == blank
    assign cta_url = routes.root_url
  endif

  assign show_cta = false
  if s.cta_label != blank
    assign show_cta = true
  endif

  assign avatars = ''
  if s.avatar_1 != blank
    assign avatars = avatars | append: '1,'
  endif
  if s.avatar_2 != blank
    assign avatars = avatars | append: '2,'
  endif
  if s.avatar_3 != blank
    assign avatars = avatars | append: '3,'
  endif
  if s.avatar_4 != blank
    assign avatars = avatars | append: '4,'
  endif

  assign motion = s.enable_float
  if settings.cc_motion == false
    assign motion = false
  endif
-%}

  {%- render 'cc-hero-styles', s: s, uid: uid, motion: motion -%}

<style>
  #shopify-section-{{ uid }} .cc-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-block-size: 44px;
    margin-top: calc({{ s.cta_mt_min }} * 1px + ({{ s.cta_mt_max }} - {{ s.cta_mt_min }}) * var(--cc-fluid-t));
    padding: {{ s.cta_pad_y }}px {{ s.cta_pad_x }}px;
    border: 0;
    border-radius: 999px;
    background: {{ s.color_accent }} !important;
    color: #ffffff !important;
    font-size: calc({{ s.cta_fs_mobile }} * 1px + ({{ s.cta_fs_desktop }} - {{ s.cta_fs_mobile }}) * var(--cc-fluid-t));
    font-weight: 700;
    line-height: 1.15;
    text-decoration: none;
    /* Le bouton doit encaisser n'importe quel libellé saisi dans l'éditeur :
       sans cette limite, un intitulé long débordait de son conteneur sous
       320 px et se faisait rogner. Il passe désormais sur deux lignes. */
    max-width: 100%;
    text-align: center;
    text-wrap: balance;
    box-shadow: 0 14px 32px -16px rgba(20, 18, 15, 0.45);
    transition: background 0.2s var(--cc-ease), color 0.2s var(--cc-ease), transform 0.2s var(--cc-ease);
  }

  #shopify-section-{{ uid }} .cc-hero__cta,
  #shopify-section-{{ uid }} .cc-hero__cta:visited,
  #shopify-section-{{ uid }} .cc-hero__cta:hover,
  #shopify-section-{{ uid }} .cc-hero__cta:focus-visible,
  #shopify-section-{{ uid }} .cc-hero__cta span,
  #shopify-section-{{ uid }} .cc-hero__cta svg {
    color: #ffffff !important;
  }

  #shopify-section-{{ uid }} .cc-hero__cta:hover {
    background: {{ s.color_ink }} !important;
    transform: translateY(-1px);
  }

  #shopify-section-{{ uid }} .cc-hero__cta .cc-btn__icon path {
    stroke: currentColor;
  }
</style>

<div class="cc-hero">
  <div class="cc-container cc-hero__inner">
    {%- if s.proof_text != blank or avatars != blank -%}
      <div class="cc-hero__proof">
        {%- if avatars != blank -%}
          <span class="cc-hero__avatars">
            {%- assign avatar_keys = avatars | split: ',' -%}
            {%- for key in avatar_keys -%}
              {%- liquid
                case key
                  when '1'
                    assign av = s.avatar_1
                  when '2'
                    assign av = s.avatar_2
                  when '3'
                    assign av = s.avatar_3
                  when '4'
                    assign av = s.avatar_4
                endcase
              -%}
              {%- render 'cc-round-image',
                image: av,
                size: s.avatar_size_desktop,
                loading: 'eager',
                decorative: true
              -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
        {%- if s.proof_text != blank -%}
          <span class="cc-hero__proof-text">{{ s.proof_text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <h1 class="cc-hero__title">
      {%- assign bubble_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- unless forloop.first -%}&#32;{%- endunless -%}
        {%- case block.type -%}

          {%- when 'line_break' -%}
            <br {{ block.shopify_attributes }} />

          {%- when 'text' -%}
            <span
              class="cc-hero__seg cc-hero__seg--{{ block.settings.tone }}"
              {%- if block.settings.tone == 'custom' %} style="color: {{ block.settings.custom_color }};"{% endif %}
              {{ block.shopify_attributes }}
            >{{ block.settings.text | escape }}</span>

          {%- when 'bubble' -%}
            {%- liquid
              assign delay = bubble_index | times: -13 | divided_by: 10.0
              assign bubble_index = bubble_index | plus: 1

              capture bubble_style
                echo '--cc-sz-min:'
                echo block.settings.size_mobile
                echo ';--cc-sz-max:'
                echo block.settings.size_desktop
                echo ';'
                if motion
                  echo '--cc-fx:'
                  echo block.settings.amplitude | divided_by: 2.4 | round: 2
                  echo 'px;--cc-fy:'
                  echo block.settings.amplitude
                  echo 'px;--cc-fr:'
                  echo block.settings.rotate | divided_by: 10.0
                  echo 'deg;animation-duration:'
                  echo block.settings.duration
                  echo 's;animation-delay:'
                  echo delay
                  echo 's;'
                endif
              endcapture
            -%}
            <span {{ block.shopify_attributes }}>
              {%- render 'cc-round-image',
                image: block.settings.image,
                size: block.settings.size_desktop,
                alt: block.settings.image_alt,
                decorative: block.settings.decorative,
                loading: 'eager',
                class: 'cc-bubble',
                style: bubble_style
              -%}
            </span>

        {%- endcase -%}
      {%- endfor -%}
    </h1>

    {%- if s.sub_text != blank -%}
      <p class="cc-hero__sub">{{ s.sub_text | escape }}</p>
    {%- endif -%}

    {%- if show_cta -%}
      <a class="cc-btn cc-btn--{{ s.cta_style }} cc-hero__cta" href="{{ cta_url }}">
        <span>{{ s.cta_label | escape }}</span>
        {%- if s.cta_show_arrow -%}
          <svg class="cc-btn__icon" width="17" height="14" viewBox="0 0 17 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M1 7h14M10 1.5 15.5 7 10 12.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>

  {%- if s.float_image != blank -%}
    <div class="cc-hero__float" aria-hidden="true">
      {{ s.float_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}
    </div>
  {%- endif -%}
</div>

{%- comment -%}
  ==========================================================================
  Données structurées de la section — Service
  --------------------------------------------------------------------------
  La prestation décrite par le hero est déclarée comme entité Service et
  rattachée à l'entité Organization posée par l'en-tête via son @id. Les deux
  entités se répondent au lieu de se dupliquer : c'est ce rattachement qui
  permet à Google de relier la prestation à l'entreprise.
  Rien n'est émis si le marchand n'a pas renseigné les champs.
  ==========================================================================
{%- endcomment -%}

{%- if s.schema_service_enable and s.schema_service_name != blank -%}
  {%- liquid
    assign org_id = shop.url | append: '/#organization'
    assign service_id = canonical_url | append: '#service'
    assign areas = s.schema_service_areas | strip | newline_to_br | split: '<br />'
    assign offers = s.schema_service_offers | strip | newline_to_br | split: '<br />'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": {{ service_id | json }},
      "name": {{ s.schema_service_name | json }},
      "url": {{ canonical_url | json }},
      "provider": { "@id": {{ org_id | json }} }
      {%- if s.schema_service_type != blank -%}
        ,"serviceType": {{ s.schema_service_type | json }}
      {%- endif -%}
      {%- if s.schema_service_description != blank -%}
        ,"description": {{ s.schema_service_description | json }}
      {%- endif -%}
      {%- if s.schema_service_audience != blank -%}
        ,"audience": {
          "@type": "BusinessAudience",
          "name": {{ s.schema_service_audience | json }}
        }
      {%- endif -%}
      {%- if areas.size > 0 -%}
        ,"areaServed": [
          {%- assign a = 0 -%}
          {%- for area in areas -%}
            {%- assign clean = area | strip -%}
            {%- if clean != blank -%}
              {%- if a > 0 %},{% endif -%}
              { "@type": "AdministrativeArea", "name": {{ clean | json }} }
              {%- assign a = a | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      {%- endif -%}
      {%- if offers.size > 0 -%}
        ,"hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": {{ s.schema_service_name | json }},
          "itemListElement": [
            {%- assign o = 0 -%}
            {%- for offer in offers -%}
              {%- assign clean_offer = offer | strip -%}
              {%- if clean_offer != blank -%}
                {%- if o > 0 %},{% endif -%}
                {
                  "@type": "Offer",
                  "itemOffered": { "@type": "Service", "name": {{ clean_offer | json }} }
                }
                {%- assign o = o | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
      {%- endif -%}
    }
  </script>
{%- endif -%}

{% schema %}
