    { "type": "range", "id": "item_min_height_mobile", "label": "Hauteur question mobile", "unit": "px", "min": 58, "max": 120, "step": 1, "default": 78 },
    { "type": "range", "id": "item_min_height_desktop", "label": "Hauteur question desktop", "unit": "px", "min": 70, "max": 130, "step": 1, "default": 88 },
