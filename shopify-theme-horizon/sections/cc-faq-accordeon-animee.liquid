    { "type": "range", "id": "subtitle_size_mobile", "label": "Taille sous-titre mobile", "unit": "px", "min": 13, "max": 24, "step": 1, "default": 16 },
    { "type": "range", "id": "subtitle_size_desktop", "label": "Taille sous-titre desktop", "unit": "px", "min": 14, "max": 26, "step": 1, "default": 18 },
