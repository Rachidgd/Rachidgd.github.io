    { "type": "range", "id": "header_bottom_desktop", "label": "Espace sous entête desktop", "unit": "px", "min": 48, "max": 160, "step": 2, "default": 82 },
    { "type": "range", "id": "column_gap_mobile", "label": "Espace colonnes mobile", "unit": "px", "min": 12, "max": 80, "step": 1, "default": 14 },
    { "type": "range", "id": "column_gap_desktop", "label": "Espace entre colonnes", "unit": "px", "min": 20, "max": 80, "step": 1, "default": 28 },
