    { "type": "range", "id": "icon_size", "label": "Taille icône", "unit": "px", "min": 16, "max": 34, "step": 1, "default": 18 },

    { "type": "header", "content": "Animation" },
    { "type": "range", "id": "section_fade_duration", "label": "Durée fondu section", "unit": "ms", "min": 300, "max": 1300, "step": 10, "default": 820 },
    { "type": "range", "id": "item_duration", "label": "Durée animation questions", "unit": "ms", "min": 300, "max": 1300, "step": 10, "default": 760 },
    { "type": "range", "id": "stagger_delay", "label": "Décalage entre questions", "unit": "ms", "min": 0, "max": 180, "step": 2, "default": 80 },
    { "type": "range", "id": "slide_distance_mobile", "label": "Distance animation mobile", "unit": "px", "min": 12, "max": 80, "step": 1, "default": 28 },
    { "type": "range", "id": "slide_distance_desktop", "label": "Distance animation desktop", "unit": "px", "min": 20, "max": 120, "step": 1, "default": 70 },
