    { "type": "range", "id": "reveal_max_width", "label": "Largeur maximale", "unit": "car", "min": 20, "max": 60, "step": 1, "default": 40 },
    { "type": "range", "id": "body_gap_min", "label": "Espace entre les éléments — mobile", "unit": "px", "min": 8, "max": 48, "step": 1, "default": 18 },
    { "type": "range", "id": "body_gap_max", "label": "Espace entre les éléments — desktop", "unit": "px", "min": 8, "max": 72, "step": 1, "default": 28 },

    { "type": "header", "content": "Pastilles" },
    { "type": "color", "id": "chip_bg", "label": "Fond", "default": "#3e3a35" },
    { "type": "color", "id": "chip_bg_hover", "label": "Fond au survol", "default": "#14120f" },
    { "type": "color", "id": "chip_color", "label": "Texte", "default": "#ffffff" },
    { "type": "color", "id": "chip_color_hover", "label": "Texte au survol", "default": "#ffffff" },
    { "type": "range", "id": "chip_fs_mobile", "label": "Taille du texte — mobile", "unit": "px", "min": 11, "max": 20, "step": 1, "default": 13 },
    { "type": "range", "id": "chip_fs_desktop", "label": "Taille du texte — desktop", "unit": "px", "min": 12, "max": 22, "step": 1, "default": 14 },
