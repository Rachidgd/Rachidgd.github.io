    { "type": "color", "id": "eyebrow_color", "label": "Couleur", "default": "#ff4a17" },
    {
      "type": "select",
      "id": "eyebrow_font",
      "label": "Police",
      "options": [
        { "value": "cursive", "label": "Manuscrite (police système)" },
        { "value": "var(--cc-font-heading, inherit)", "label": "Police des titres" },
        { "value": "var(--cc-font-body, inherit)", "label": "Police du texte" }
      ],
      "default": "cursive"
    },
    {
      "type": "select",
      "id": "eyebrow_style",
      "label": "Style",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "italic", "label": "Italique" }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "eyebrow_weight",
      "label": "Graisse",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    { "type": "range", "id": "eyebrow_fs_mobile", "label": "Taille — mobile", "unit": "px", "min": 14, "max": 40, "step": 1, "default": 22 },
    { "type": "range", "id": "eyebrow_fs_desktop", "label": "Taille — desktop", "unit": "px", "min": 16, "max": 56, "step": 1, "default": 28 },

